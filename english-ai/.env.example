# 服务端环境变量模板
# 复制本文件为 .env，然后填入你自己的密钥（.env 已被 git 忽略，不会提交）

# 百度智能云 - 图像识别（场景识别）
# 控制台: https://console.bce.baidu.com/ai/#/ai/imagerecognition/overview/index
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 阿里云百炼 - 通义千问（AI 英语生成）
# 控制台: https://bailian.console.aliyun.com/
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo

# 本地服务端口（可选，默认 8787）
PORT=8787
